# Copy this file to .env and add your own Gemini key.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional alternative provider. Either Gemini or Anthropic is sufficient.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional model overrides. These defaults are supported by the configured providers.
# INTERVIEW_GEMINI_MODEL=gemini-3.8-flash
# INTERVIEW_ANTHROPIC_MODEL=claude-sonnet-4-6
